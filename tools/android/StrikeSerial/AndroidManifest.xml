<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.lazersport.strikeserial">

    <uses-sdk android:minSdkVersion="21" />

    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <!-- a TV ligou: abre o jogo (StrikeLigou) -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Android 10+: abrir o jogo "de fundo" (ao ligar e pelo guarda) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- o adb da propria TV (127.0.0.1): o jogo se prepara sozinho -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- acender a tela ao ligar -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- o guarda (StrikeSempre): servico em primeiro plano -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- MODO FEIRA: os cadastros vão para o pendrive (raiz dele, onde o Android deixar) -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- Android 11+: enxergar a tela inicial da TV, para sair do jogo (InicioDaTv) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <application android:banner="@drawable/gol_flash_banner">
        <!-- encaixe do Arduino: "Usar por padrão" guarda a permissão USB.
             directBootAware: AO LIGAR A CAIXA o Android procura o app padrão
             do Arduino JA NO COMECO da inicializacao, antes de "destravar" o
             armazenamento (caixas com Android 9 ou mais novo). Sem isto esta
             atividade fica invisivel nessa hora, o Android nao acha o app
             padrao, NAO da a permissao guardada e o jogo tinha de pedir a
             janela de novo a cada vez que a caixa ligava. (Nas caixas antigas,
             Android 7, nao ha essa etapa: por isso la sempre funcionou.) -->
        <activity
            android:name="com.lazersport.strikeserial.StrikeArduinoAtivo"
            android:directBootAware="true"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/strike_usb_arduino" />
        </activity>
        <!-- DESLIGADO (android:enabled="false" nos 3 abaixo): hoje quem abre o
             jogo ao ligar a TV Box e o app AUTO START. Para voltar a abrir
             sozinho: enabled="true" nos 3 e InicioDaTv.ABRIR_SOZINHO = true.
             O JOGO ABRE SOZINHO AO LIGAR (o metodo do Dragon Bowling / Strike
             Kids): a tela inicial invisivel que traz o jogo, o aviso de
             "ligou" e o guarda que mantem o jogo na tela -->
        <activity
            android:name="com.lazersport.strikeserial.StrikeInicioAtivo"
            android:directBootAware="true"
            android:enabled="false"
            android:exported="true"
            android:excludeFromRecents="true"
            android:stateNotNeeded="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <!-- directBootAware: sem isto o Android esquece a escolha "Sempre"
                 a cada vez que a TV liga (ver StrikeInicioAtivo.java) -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- A TV LIGOU. directBootAware + LOCKED_BOOT_COMPLETED: o aviso chega
             ja no comeco da inicializacao; prioridade maxima; QUICKBOOT: as
             caixas com "inicializacao rapida"; MY_PACKAGE_REPLACED: depois
             de instalar uma atualizacao o jogo abre sozinho. -->
        <receiver
            android:name="com.lazersport.strikeserial.StrikeLigou"
            android:directBootAware="true"
            android:enabled="false"
            android:exported="true">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.REBOOT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <service
            android:name="com.lazersport.strikeserial.StrikeSempre"
            android:directBootAware="true"
            android:enabled="false"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="quiosque: mantem o jogo da maquina de arcade na tela da TV" />
        </service>
        <meta-data
            android:name="org.godotengine.plugin.v2.StrikeSerial"
            android:value="com.lazersport.strikeserial.StrikeSerial" />
    </application>
</manifest>
