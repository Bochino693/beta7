; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Olho no Lance"
config/description="Olho no Lance - jogo arcade de futebol da Lazer & Sport Games"
run/main_scene="res://scenes/opening.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
boot_splash/bg_color=Color(0.003, 0.008, 0.016, 1)
boot_splash/image="res://branding/splash_gol_flash_arena.png"
boot_splash/fullsize=true
boot_splash/stretch_mode=4
boot_splash/use_filter=true
config/icon="res://gol_flash_arena_oficial.png"
config/quit_on_go_back=false

[autoload]

PlayersGlobal="*res://players_global.gd"
CupGlobal="*res://scripts/CupGlobal.gd"
ChampionsDb="*res://scripts/champions_db.gd"
ArcadeData="*res://scripts/arcade_data.gd"
ArduinoBridge="*res://scripts/arduino_bridge.gd"
Visual="*res://scripts/visual.gd"
Efeitos="*res://scripts/efeitos.gd"
ControleTv="*res://scripts/controle_tv.gd"
Leads="*res://scripts/leads.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[gui]

theme/custom_font="res://fonts/Barlow-SemiBold.ttf"

[input]

input_start={
"deadzone": 0.2,
"events": [Object(InputEventJoypadButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"button_index":6,"pressure":0.0,"pressed":true,"script":null)
]
}
