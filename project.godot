; Engine configuration file.
; Gol Flash Arena — versão TV Box S905L (Android 7.1, Mali-450, Godot 3.6).
; Sensores, START e SELECT chegam do Arduino Nano pela USB
; (scripts/arduino_nano.gd); no PC, pelo teclado:
;   1/Espaço = START, 2 = SELECT, 5 = crédito, A S D F G H J = alvos A..G.

config_version=4

[application]

config/name="Gol Flash Arena"
config/description="Gol Flash Arena - TV Box S905L (Android 7.1)"
run/main_scene="res://scenes/opening.tscn"
boot_splash/image="res://branding/splash_gol_flash_arena.png"
boot_splash/fullsize=true
boot_splash/use_filter=true
boot_splash/bg_color=Color( 0.003, 0.008, 0.016, 1 )
config/icon="res://gol_flash_arena_oficial.png"

[audio]

default_bus_layout=""

[autoload]

Compat="*res://scripts/compat_g3.gd"
Arduino="*res://scripts/arduino_nano.gd"
PlayersGlobal="*res://players_global.gd"
CupGlobal="*res://scripts/CupGlobal.gd"
ChampionsDb="*res://scripts/champions_db.gd"
ArcadeData="*res://scripts/arcade_data.gd"

[display]

window/size/width=1280
window/size/height=720
window/size/fullscreen=true
window/handheld/orientation="sensor_landscape"
window/stretch/mode="2d"
window/stretch/aspect="expand"
window/energy_saving/keep_screen_on=true

[gui]

common/drop_mouse_on_gui_input_disabled=true

